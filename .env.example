# Local development (SQLite file in project root)
DATABASE_URL="file:./dev.db"

# Production (Turso — durable SQLite for serverless)
# TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
# TURSO_AUTH_TOKEN="..."

# Service-to-service secret for AiEA → BF (Bearer / X-BF-Integration-Key)
# Generate a long random string; set the same value on AiEA as BF_INTEGRATION_SECRET
BF_INTEGRATION_SECRET="change-me-long-random-integration-secret"

# AiEA origin (no trailing slash). Required.
# - GET {AIEA_URL}/api/session verifies the browser's aiea_session cookie
# - complete/reopen sync posts to {AIEA_URL}/api/integrations/bf-maintenance/*
# Local: AiEA on :3000. Alias also accepted: AIEA_BASE_URL
# AIEA_URL="http://127.0.0.1:3000"
# Optional when AiEA preview deployment protection is on:
# AIEA_PROTECTION_BYPASS=""

# Verify harness (local/CI) — dedicated AiEA smoke user; never a personal account
# AIEA_SMOKE_EMAIL="aiea-smoke@example.com"
# AIEA_SMOKE_PASSWORD="(from gh secret / password manager — never commit)"
